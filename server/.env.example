# Copy to server/.env locally. Never commit a real .env, token, password or database.
# Default local mode uses SQLite; leave these blank unless using hosted Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Required persistent secret for NODE_ENV=production. Generate securely, do not reuse.
JWT_SECRET=
# Local default host is 127.0.0.1. Render production uses 0.0.0.0.
# HOST=0.0.0.0
# PORT=3000
# TZ=Asia/Kolkata
# Demo users are on locally and off in production unless explicitly enabled.
# SEED_DEMO_USERS=false
# First-admin setup; only used when there is no admin. Password: 12–100 characters.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Clinic Administrator
# Choose smtp locally, or gmail_api on hosts blocking SMTP (e.g. Render Free).
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
# Gmail HTTPS API: authorize only gmail.send using YOUR OAuth client.
# This uses a Google OAuth refresh token, not an app password.
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Comma-separated approved test recipients. Required in production; no wildcards.
MAIL_ALLOWED_RECIPIENTS=
